	/* INTRO */
	/* AGENT ULGRIN */
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\BeforeDoorOpen.ogg": [
		{
			"text": "Controllo, qui è l'agente Ulgrin. Richiedo l'apertura della cella 3-11.",
			"delay": 3.7,
			"color": "guard",
			"length": 4.0
		},
		{
			"text": "Ricevuto.",
			"delay": 8.9,
			"length": 0.91
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\ExitCell.ogg": [
		{
			"text": "Ehi, hanno del lavoro per te. Fammi un favore, esci dalla tua cella.",
			"delay": 1.37,
			"color": "guard",
			"length": 4.14
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\ExitCellRefuse0.ogg": [
		{
			"text": "Ma sei stupido o cosa? Ti ho detto di uscire dalla cella. Se non esci dalla cella, ti prendo a calci nel culo.",
			"color": "guard",
			"length": 6.05
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\ExitCellRefuse1.ogg": [
		{
			"text": "Senti, amico, non ho tutto il giorno. Sto cercando di essere gentile. Se non esci dalla cella, ti prendo a calci nel culo.",
			"color": "guard",
			"length": 5.6
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\CellGas0.ogg": [
		{
			"text": "*RIDE* Devi essere il soggetto più stupido che abbiamo mai avuto! Beh, chiudi le porte e apri le valvole del gas.",
			"color": "guard",
			"length": 7.05
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\CellGas1.ogg": [
		{
			"text": "Eh. In realtà sono un po' deluso che tu non abbia opposto resistenza. Non vedevo l'ora di darti un pugno in faccia.",
			"color": "guard",
			"length": 5.71
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\Escort0.ogg": [
		{
			"text": "Seguimi e basta. Oh, e a proposito, siamo autorizzati a uccidere qualsiasi soggetto disobbediente. Quindi non fare sciocchezze.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\Escort1.ogg": [
		{
			"text": "Seguimi. Oh, e a proposito, siamo autorizzati a eliminare qualsiasi soggetto disobbediente. Quindi ti consiglio di non fare sciocchezze.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortRun.ogg": [
		{
			"text": "Ehi, idiota! Stai andando nella direzione sbagliata! Vieni subito qui, cavolo.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortRefuse0.ogg": [
		{
			"text": "Sbrigati! Ti stanno aspettando!",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortRefuse1.ogg": [
		{
			"text": "Senti, amico, già odio il mio lavoro. Perché mi rendi le cose ancora più difficili?",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortPissedOff0.ogg": [
		{
			"text": "Non sono dell'umore giusto per queste stronzate. Non avrò alcun problema a piantarti una pallottola in testa se non inizi a collaborare.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortPissedOff1.ogg": [
		{
			"text": "Non sono dell'umore giusto per queste stronzate! Non avrò alcun problema a piantarti una pallottola in testa se non inizi a collaborare.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortKill0.ogg": [
		{
			"text": "Va bene, sai una cosa, va bene. Fai pure. Troveremo qualcun altro allora.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortKill1.ogg": [
		{
			"text": "Va bene, d'accordo. Fai pure. Troveremo qualcun altro allora.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortTerminated.ogg": [
		{
			"text": "Mi occuperò io del corpo. Tu vai a prenderne un altro...",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortDone0.ogg": [
		{
			"text": "Bene, siamo arrivati. Entra e segui tutte le istruzioni e... probabilmente andrà tutto bene.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortDone1.ogg": [
		{
			"text": "Beh, siamo arrivati. Sono ancora deluso per non averti dato un pugno, ma... pazienza.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortDone2.ogg": [
		{
			"text": "Beh, eccoci qui. Sono ancora deluso di non averti dato un pugno in faccia, ma... pazienza.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortDone3.ogg": [
		{
			"text": "Entra e segui tutte le istruzioni e... probabilmente andrà tutto bene. O forse no. In ogni caso, non mi interessa.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Ulgrin\\EscortDone4.ogg": [
		{
			"text": "Beh, comunque, non perdiamo altro tempo. Ti stanno aspettando nella cella.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\WhatThe0b.ogg": [
		{
			"text": "Oh merda!",
			"delay": 1.15,
			"color": "guard"
		},
		{
			"text": "Va bene, ho capito.",
			"delay": 7.78,
			"color": "guard"
		}
	],
	/* ESCAPE GUARD */
	"SFX\\Room\\Intro\\Guard\\PlayerEscape.ogg": [
		{
			"text": "Ma che diavolo? Ehi! Fermati! Sta scappando!",
			"color": "guard"
		}
	],
	/* GUARD CONVERSATION */
	"SFX\\Room\\Intro\\Guard\\Conversation0a.ogg": [
		{
			"text": "Allora... come va?",
			"color": "guard"
		},
		{
			"text": "Beh, sì, con chi pensi che stia parlando? Con questo tizio dalla faccia da schiaffi? Ovviamente sto parlando con te.",
			"delay": 5.3,
			"color": "guard"
		},
		{
			"text": "Beh, sì. È il tuo primo giorno di lavoro qui.",
			"delay": 15.4,
			"color": "guard"
		},
		{
			"text": "Davvero? Wow. Che strano.",
			"delay": 23.65,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation0b.ogg": [
		{
			"text": "Ehm... stai parlando con me?",
			"delay": 3.2,
			"color": "guard"
		},
		{
			"text": "Oh! Sono solo un po' sorpreso. Credo che questa sia la prima volta che mi rivolgi la parola.",
			"delay": 10.33,
			"color": "guard"
		},
		{
			"text": "Ehm... in realtà lavoriamo insieme da circa cinque mesi.",
			"delay": 18.95,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation1a.ogg": [
		{
			"text": "Ehm... hai visto qualche bel film ultimamente?",
			"color": "guard"
		},
		{
			"text": "Sì? Che tipo di libri?",
			"delay": 7.19,
			"color": "guard"
		},
		{
			"text": "Eh, mi prendi in giro?",
			"delay": 12.5,
			"color": "guard"
		},
		{
			"text": "Il tuo lavoro ruota interamente attorno all'horror e alla fantascienza! Solo che, come ben sai, non si tratta di finzione.",
			"delay": 15.93,
			"color": "guard"
		},
		{
			"text": "Sì, senti, senza offesa, ma ho già perso interesse per quello di cui stai parlando.",
			"delay": 24.73,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation1b.ogg": [
		{
			"text": "Ehm, io... non guardo molti film. Leggo soprattutto libri.",
			"delay": 3.27,
			"color": "guard"
		},
		{
			"text": "Uh, horror. Fantascienza. Cose del genere.",
			"delay": 9.0,
			"color": "guard"
		},
		{
			"text": "Cosa?",
			"delay": 14.8,
			"color": "guard"
		},
		{
			"text": "Beh, in realtà sto pensando di scrivere un libro sulla mia...",
			"delay": 22.5,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation2a.ogg": [
		{
			"text": "Cavolo, ho fame. Ehi, oggi è il giorno della pizza alla mensa, vero?",
			"color": "guard"
		},
		{
			"text": "Oh, maledizione. Beh, la mia giornata è rovinata. L'unico motivo per cui continuo a venire qui è per la pizza. Non so cosa abbia di speciale quella pizza, ma è deliziosa.",
			"delay": 7.65,
			"color": "guard"
		},
		{
			"text": "La casseruola di tonno, invece, è un abominio disgustoso e dovrebbe essere rinchiusa qui dentro insieme al resto di questi mostri.",
			"delay": 16.5,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation2b.ogg": [
		{
			"text": "Ehm, in realtà credo sia il giorno della casseruola di tonno.",
			"delay": 4.6,
			"color": "guard"
		},
		{
			"text": "Ehm... ok?",
			"delay": 22.93,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation3a.ogg": [
		{
			"text": "Non hai una ragazza, vero?",
			"color": "guard"
		},
		{
			"text": "Beh, di certo non sono un telepate. Altrimenti sarei rinchiuso in questo posto. Quindi sì, direi che è piuttosto ovvio.",
			"delay": 3.3,
			"color": "guard"
		},
		{
			"text": "Dille che lavori in una caffetteria o qualcosa del genere.",
			"delay": 13.51,
			"color": "guard"
		},
		{
			"text": "Ehm, non lo so! Dille solo che è... ketchup.",
			"delay": 23.55,
			"color": "guard"
		},
		{
			"text": "Uff... lascia perdere.",
			"delay": 30.45,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation3b.ogg": [
		{
			"text": "È così evidente?",
			"delay": 1.94,
			"color": "guard"
		},
		{
			"text": "Beh, come potrei mai trovare una ragazza con questo lavoro? Insomma, non posso certo parlargliene.",
			"delay": 9.14,
			"color": "guard"
		},
		{
			"text": "Beh, e se per caso mi fossi dimenticato di lavarmi le mani qui al lavoro, fossi tornato a casa e avessi avuto le mani sporche di sangue? Cosa dovrei dirle allora?",
			"delay": 16.2,
			"color": "guard"
		},
		{
			"text": "Ketchup? Perché dovrei avere del ketchup sulle mani se lavoro in una caffetteria?",
			"delay": 26.5,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation4a.ogg": [
		{
			"text": "Ehm... hai visto qualche bel film ultimamente?",
			"color": "guard"
		},
		{
			"text": "Oh, ok. Oh, e i videogiochi? Sai, questo mi ricorda che qualcuno dovrebbe creare un videogioco basato su questo posto.",
			"delay": 5.4,
			"color": "guard"
		},
		{
			"text": "Eh, non lo so. Ho solo pensato che fosse un'idea interessante.",
			"delay": 13.5,
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Conversation4b.ogg": [
		{
			"text": "Ehm, io... non guardo molti film.",
			"delay": 3.2,
			"color": "guard"
		},
		{
			"text": "Perché qualcuno dovrebbe farlo?",
			"delay": 11.5,
			"color": "guard"
		},
		{
			"text": "Beh, nemmeno ci gioco ai videogiochi.",
			"delay": 17.0,
			"color": "guard"
		}
	],
	/* BALCONY GUARD */
	"SFX\\Room\\Intro\\Guard\\Balcony\\Alert0.ogg": [
		{
			"text": "Ehi, fifone, faresti meglio a riportare il tuo culo nella camera adesso. Non te lo chiederò di nuovo.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Balcony\\Alert1.ogg": [
		{
			"text": "Pensavi davvero di poter uscire da qui senza che me ne accorgessi? Torna subito nella camera.",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Balcony\\OhShit.ogg": [
		{
			"text": "Oh, merda. Oh merda! Merda!",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Balcony\\WTF0.ogg": [
		{
			"text": "Che cazzo sta succedendo?",
			"color": "guard"
		}
	],
	"SFX\\Room\\Intro\\Guard\\Balcony\\WTF1.ogg": [
		{
			"text": "Che cazzo sta succedendo!?",
			"color": "guard"
		}
	],
	/* FRANKLIN */
	"SFX\\Room\\Intro\\WhatThe0a.ogg": [
		{
			"text": "Agente, dietro di te!"
		},
		{
			"text": "Tieni gli occhi fissi su di lui!",
			"delay": 1.65
		},
		{
			"text": "Va bene, ora chiuderò gli occhi. Tu continua a guardarlo.",
			"delay": 4.82
		}
	],
	"SFX\\Room\\Intro\\Scientist\\Franklin\\EnterChamber.ogg": [
		{
			"text": "Attenzione a tutto il personale di classe D, entrare nella camera di contenimento.",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\Scientist\\Franklin\\Refuse0.ogg": [
		{
			"text": "Soggetto D-9341, entra nella camera di contenimento o verrai eliminato!",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\Scientist\\Franklin\\Refuse1.ogg": [
		{
			"text": "Questo è il tuo ultimo avvertimento, hai cinque secondi per obbedire!",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\Scientist\\Franklin\\Refuse2.ogg": [
		{
			"text": "Oggetto D-9341 designato per l'eliminazione. Fuoco a volontà!",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\Scientist\\Franklin\\Approach173.ogg": [
		{
			"text": "Si prega di avvicinarsi all'SCP-173 per il test.",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\Scientist\\Franklin\\Problem.ogg": [
		{
			"text": "Ehm, sembra esserci un problema con il sistema di controllo delle porte. Le porte non rispondono a nessuno dei nostri tentativi di chiuderle. Quindi, vi prego di mantenere un contatto visivo diretto con l'SCP-173.",
			"color": "announcement",
			"length": 6.57
		}
	],
	/* CLASS-D */
	"SFX\\Room\\Intro\\ClassD\\DontLikeThis.ogg": [
		{
			"text": "Non mi piace. Proprio per niente.",
			"color": "classd"
		}
	],
	"SFX\\Room\\Intro\\ClassD\\Breen.ogg": [
		{
			"text": "Aspetta, ma che...",
			"color": "classd"
		}
	],
	/* SCIENTIST */
	"SFX\\Room\\Intro\\Scientist\\Conversation.ogg": [
		{
			"text": "Per qualche motivo è passato davanti alla camera di 079 e ora le porte non funzionano."
		},
		{
			"text": "Beh, almeno non funzionavano l'ultima volta che sono passato di lì.",
			"delay": 5.0
		},
		{
			"text": "Skinner?",
			"delay": 12.2
		},
		{
			"text": "Hmm, non lo ricordo.",
			"delay": 15.4
		},
		{
			"text": "È mai stato di stanza in questo settore?",
			"delay": 17.65
		},
		{
			"text": "Sì, lungo la strada ha preso un agente di sicurezza e un ricercatore junior.",
			"delay": 25.3
		},
		{
			"text": "Il ragazzo stava portando dei documenti al suo supervisore, che schifo.",
			"delay": 29.5
		},
		{
			"text": "Questo ha sconvolto parecchio il dottor L.",
			"delay": 36.2
		},
		{
			"text": "Non ha lasciato il suo ufficio, dice di aver sentito delle cose.",
			"delay": 38.2
		}
	],
