	"SFX\\Room\\Intro\\IA\\Scripted\\Announcement0.ogg": [
		{
			"text": "Non dimenticare che oggi è il giorno della pizza. Quindi vai alla mensa e prenditi una fetta calda.",
			"delay": 1.9,
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Announcement1.ogg": [
		{
			"text": "Ricordate, la sicurezza è il primo passo verso un ambiente di lavoro sicuro. Siate prudenti, siate vigili.",
			"delay": 1.85,
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Announcement2.ogg": [
		{
			"text": "Ricordiamo a tutto il personale che ogni giovedì, dalle 17 alle 18, si tengono seminari motivazionali nell'auditorium della facoltà. Venite a trovarci e lasciatevi motivare!",
			"delay": 2.0,
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Announcement3.ogg": [
		{
			"text": "Ricordatevi di segnalare tutte le attività sospette ai vostri superiori. Nessuno è esente da controlli. Siate paranoici. Siate vigili.",
			"delay": 1.95,
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Announcement4.ogg": [
		{
			"text": "Ti senti fuori forma? Passa dalla palestra della facoltà e partecipa a una partita di badminton della comunità la domenica!",
			"delay": 2.0,
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Announcement5.ogg": [
		{
			"text": "Ti senti stanco e oberato di lavoro? Il caffè appena preparato è servito alla caffetteria a tutte le ore.",
			"delay": 2.0,
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Announcement6.ogg": [
		{
			"text": "Venite a partecipare alla nostra serata cinema annuale questo sabato! Il film di quest'anno è 'Area 51: Panico e terrore: due miglia sotto terra'",
			"delay": 1.95,
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Scripted0.ogg": [
		{
			"text": "Attenzione. Il capo della sicurezza Franklin, si rechi immediatamente alla camera di contenimento 173.",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Scripted1.ogg": [
		{
			"text": ">Il Dottor L, si rechi al checkpoint C dell'area di contenimento pesante.",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Scripted2.ogg": [
		{
			"text": "Attenzione. Il Dottor Maynard, si presenti immediatamente all'ufficio amministrativo.",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Scripted3.ogg": [
		{
			"text": "Squadra di manutenzione Alpha, presentarsi all'ascensore 6A del Contenimento Leggero per l'ispezione di sicurezza.",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Scripted4.ogg": [
		{
			"text": "Attenzione. Il direttore del sito Rosewood, si rechi al complesso amministrativo.",
			"color": "announcement"
		}
	],
	"SFX\\Room\\Intro\\IA\\Scripted\\Scripted5.ogg": [
		{
			"text": "Attenzione. A tutto il personale, presentarsi a...",
			"delay": 2.2,
			"color": "announcement"
		},
		{
			"text": "*SUONI INCOMPRENSIBILI*",
			"delay": 5.6,
			"color": "announcement"
		},
		{
			"text": "Immediatamente.",
			"delay": 7.65,
			"color": "announcement"
		}
	],
	"SFX\\Alarm\\Alarm1_1.ogg": [
		{
			"text": "Questo sito sta subendo diverse violazioni di contenimento di livello Keter ed Euclid. Avviato il blocco totale del sito.",
			"delay": 0.6,
			"color": "announcement"
		}
	],
	/* CHARACTERS */
	"SFX\\Character\\Maintenance\\EscapeFromClosets.ogg": [
		{
			"text": "Penso che la via d'uscita più breve sia attraverso l'ala sud-est. Seguitemi.",
			"color": "crew"
		}
	],
	"SFX\\Character\\Scientist\\EscapeFromClosets.ogg": [
		{
			"text": "Hai sentito?"
		},
		{
			"text": "Spero che non fosse...",
			"delay": 1.9
		}
	],
	/* 096 GUARD */
	"SFX\\Character\\Guard\\096ServerRoom0.ogg": [
		{
			"text": "Ehilà?",
			"delay": 1.4,
			"color": "guard"
		},
		{
			"text": "Oddio...",
			"delay": 4.7,
			"color": "guard"
		},
		{
