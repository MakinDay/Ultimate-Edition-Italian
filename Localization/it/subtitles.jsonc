	"SFX\\Character\\MTF\\TeslaRequest.ogg": [
		{
			"text": "Nine-Tailed Fox a controllo, richiesta di disattivazione del cancello Tesla più vicino alla nostra posizione.",
			"delay": 0.4,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ThereHeIs0.ogg": [
		{
			"text": "Classe D trovato!",
			"delay": 0.15,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ThereHeIs1.ogg": [
		{
			"text": "Eccolo lì! Spariamo!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ThereHeIs2.ogg": [
		{
			"text": "Eccoti qua.",
