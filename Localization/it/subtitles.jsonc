		}
	],
	"SFX\\Character\\MTF\\ThereHeIs3.ogg": [
		{
			"text": "Guardate, è lì!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ThereHeIs4.ogg": [
		{
			"text": "A-ha! Ho trovato il Classe D!",
			"delay": 0.2,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ThereHeIs5.ogg": [
		{
			"text": "Oh, ehi, è un Classe D!",
			"delay": 0.2,
			"color": "mtf"
		}
	],
		"SFX\\Character\\MTF\\OMFG.ogg": [
		{
			"text": "OH MIO DIO, CAZZO!",
			"delay": 0.09,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\049_2\\Spotted.ogg": [
		{
			"text": "Nine-Tailed Fox a controllo, rilevata un'istanza attiva di SCP-049-2.",
			"delay": 0.2,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\049_2\\TargetTerminated.ogg": [
		{
			"text": "SCP-049-2 terminato.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\049\\Spotted0.ogg": [
		{
			"text": "Occhi alle spalle, SCP-049 individuato!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\049\\Spotted1.ogg": [
		{
			"text": "SCP-049 nell'area! Occhi aperti.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\049\\Spotted2.ogg": [
		{
			"text": "L'SCP-049 ci sta addosso! Occhi alle spalle.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\049\\Spotted3.ogg": [
		{
			"text": "È stato avvistato il medico della peste! Mantenete tutti la calma.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\049\\Spotted4.ogg": [
		{
			"text": "Il medico della peste è stato appena avvistato!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\096\\Spotted0.ogg": [
		{
			"text": "L'SCP-096 è stato avvistato. Avvio procedura SCRAMBLE.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\096\\Spotted1.ogg": [
		{
			"text": "Ho individuato l'SCP-096, passo.",
			"delay": 0.5,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\106\\AlreadyCaptured.ogg": [
		{
			"text": "Sembra che qualcuno abbia già catturato l'SCP-106. Procediamo con gli obiettivi secondari.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\106\\FoundChamber.ogg": [
		{
			"text": "Abbiamo raggiunto la cella di contenimento dell'SCP-106.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\106\\Protocol.ogg": [
		{
			"text": "Avvio del protocollo di richiamo...",
			"color": "mtf"
		},
		{
			"text": "SCP-106 catturato con successo.",
			"delay": 8.0,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\106\\Spotted0.ogg": [
		{
			"text": "SCP-106 avvistato! In fuga!",
			"delay": 0.218,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\106\\Spotted1.ogg": [
		{
			"text": "Il Vecchio sta uscendo! Andiamocene da qui, cazzo.",
			"delay": 0.1,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\106\\Spotted2.ogg": [
		{
			"text": "Ho individuato l'SCP-106, scappiamo!",
			"delay": 0.09,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\106\\Spotted3.ogg": [
		{
			"text": "Lasciamo perdere il D, dobbiamo scappare!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Spotted0.ogg": [
		{
			"text": "SCP-173 individuato!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Spotted1.ogg": [
		{
			"text": "SCP-173 avvistato!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Spotted2.ogg": [
		{
			"text": "Dimentichiamoci del D, concentriamoci sulla statua.",
			"delay": 0.65,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Blinking.ogg": [
		{
			"text": "Chiudo gli occhi.",
			"color": "mtf",
			"length": 2.0
		}
	],
	"SFX\\Character\\MTF\\173\\Box0.ogg": [
		{
			"text": "L'SCP-173 è stato riposto nella scatola di contenimento. Lo trasferiamo alla sua cella.",
			"delay": 0.06,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Box1.ogg": [
		{
			"text": "La statua è nella scatola. La sto portando nella camera di contenimento.",
			"delay": 0.1,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Box2.ogg": [
		{
			"text": "Comando, abbiamo inscatolato l'SCP-173. Ci stiamo spostando verso la sua camera di contenimento per confinarlo, chiudo.",
			"delay": 0.57,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Cont0.ogg": [
		{
			"text": "L'SCP-173 è nella cella di contenimento. Chiusura porta.",
			"delay": 0.4,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Cont1.ogg": [
		{
			"text": "La statua è nella cella. Chiusura delle porte.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Cont2.ogg": [
		{
			"text": "L'SCP-173 è tornato in contenimento. Procediamo al prossimo obiettivo.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\173\\Cont3.ogg": [
		{
			"text": "L'SCP-173 è stato messo in sicurezza nella sua camera di contenimento.",
			"delay": 0.4,
			"color": "mtf"
		},
		{
			"text": "Passiamo al prossimo obiettivo, chiudo.",
			"delay": 5.35,
			"color": "mtf"
		}
	],
	/* SCPS */
	/* 035 */
	"SFX\\Radio\\035Help0.ogg": [
		{
			"text": "Ehilà? Per favore, qualcuno mi sente?",
			"delay": 0.7
		},
		{
			"text": "Qualcuno può aiutarmi? Ho bisogno di aiuto e anche di cure mediche! Per favore!",
			"delay": 4.9
		},
		{
			"text": "Attualmente mi trovo nella Zona di Contenimento Pesante oltre il Checkpoint E e sono rinchiuso nella camera di contenimento dell'SCP-035.",
			"delay": 12.2
		}
	],
	"SFX\\Radio\\035Help1.ogg": [
		{
			"text": "Per favore! Conosco bene questo complesso. Se mi aiuterete a uscire da qui, vi aiuterò a lasciare la struttura e a raggiungere la superficie!",
			"delay": 0.6
		}
	],
	"SFX\\SCP\\035\\Help0.ogg": [
		{
			"text": "Oh, grazie a Dio!",
			"delay": 0.57
		},
		{
			"text": "Qualcuno mi ha davvero trovato! Per un attimo ho pensato di essere finito, ahah!",
			"delay": 2.48
		}
	],
	"SFX\\SCP\\035\\Help1.ogg": [
		{
			"text": "Posso riportarci entrambi in superficie sani e salvi. Basta trovare il pannello di controllo lì dentro e aprirmi le porte della camera."
		}
	],
	"SFX\\SCP\\035\\Idle0.ogg": [
		{
			"text": "Allora? Cosa stai aspettando?",
			"delay": 0.19
		}
	],
	"SFX\\SCP\\035\\Idle1.ogg": [
		{
			"text": "Cosa? Non..."
		},
		{
			"text": "Va bene, lo ammetto, non ti biasimerei se non mi ritenessi affidabile. Ma, ti prego! Ho bisogno del tuo aiuto e in fretta!",
			"delay": 1.78
		},
		{
			"text": "La maschera è rimasta attaccata al mio viso per un po' di tempo e penso che potrei aver bisogno di cure mediche, altrimenti potrebbe uccidermi dall'interno.",
			"delay": 9.0
		},
		{
			"text": "Lasciami uscire così posso trovare un'uscita in poco tempo.",
			"delay": 15.0
		}
	],
	"SFX\\SCP\\035\\Idle2.ogg": [
		{
			"text": "*SOSPIRO*"
		},
		{
			"text": "Sto iniziando a perdere la pazienza.",
			"delay": 1.75
		}
	],
	"SFX\\SCP\\035\\Idle3.ogg": [
		{
			"text": "Cosa ci fai lì impalato?",
			"delay": 0.3
		}
	],
	"SFX\\SCP\\035\\Idle4.ogg": [
		{
			"text": "Sai... la task force mobile entrerà nella struttura da un momento all'altro.",
			"delay": 0.7
		},
		{
			"text": "Indovina cosa fanno ai vagabondi di classe D come te?",
			"delay": 5.4
		}
	],
	"SFX\\SCP\\035\\Idle5.ogg": [
		{
			"text": "Ma mi stai ascoltando?",
			"delay": 0.5
		}
	],
	"SFX\\SCP\\035\\Idle6.ogg": [
		{
			"text": "Va bene. Buona fortuna ad uscire da solo.",
			"delay": 0.95,
			"color": "035"
		}
	],
	"SFX\\SCP\\035\\Closet0.ogg": [
		{
			"text": "Ok, ascolta.",
			"delay": 0.64
		},
		{
			"text": "Se ancora non mi ritieni abbastanza affidabile, dietro di te c'è un magazzino chiuso a chiave. Probabilmente avrai notato che è protetto da un codice di accesso a 4 cifre.",
			"delay": 2.24
		},
		{
			"text": "All'interno ci sono alcune attrezzature utili. Oltre a una pillola di SCP-500.",
			"delay": 9.7
		},
		{
			"text": "Il codice di accesso è 5-7-3-1. Capito?",
			"delay": 14.9
		},
		{
			"text": "5-7-3-1.",
			"delay": 19.7
		}
	],
	"SFX\\SCP\\035\\Closet1.ogg": [
		{
			"text": "Vedi? Puoi fidarti di me. Ora, per favore, sbrigati e apri la porta!",
			"delay": 0.43
		}
	],
	"SFX\\SCP\\035\\Escape.ogg": [
		{
			"text": "Purtroppo, non ho mai avuto alcuna intenzione di portarti con me. Quindi è qui che le nostre strade si dividono."
		},
		{
			"text": "Ma per amore della mia libertà,",
			"delay": 6.0
		},
		{
			"text": "Ho motivo di credere che SCP-079 abbia preso il controllo dei sistemi della struttura, compreso il sistema delle porte.",
			"delay": 8.7
		},
		{
			"text": "La soluzione migliore è cercare di convincerlo in qualche modo. Se ti va bene riuscirai ad arrivare a un compromesso. Tuttavia, non controlla le testate nucleari.",
			"delay": 15.8
		},
		{
			"text": "Che dovresti disattivare da remoto nel caso in cui qualcosa vada storto.",
			"delay": 23.8
		}
	],
	"SFX\\SCP\\035\\Gased0.ogg": [
		{
			"text": "Aspetta? Che diavolo stai facendo? Che diavolo stai..."
		},
		{
			"text": "*SOFFOCAMENTO*",
			"delay": 2.95
		},
		{
			"text": "Per favore... Perché...",
			"delay": 5.0
		},
		{
			"text": "Per favore, ti prego...",
			"delay": 6.28
		},
		{
			"text": "Non riesco a respirare!",
			"delay": 8.0
		},
		{
			"text": "No!",
			"delay": 10.45
		},
		{
			"text": "*TOSSISCE*",
			"delay": 11.9
		}
	],
	"SFX\\SCP\\035\\Gased1.ogg": [
		{
			"text": "*SOFFOCAMENTO*"
		}
	],
	"SFX\\SCP\\035\\GasedStop0.ogg": [
		{
			"text": "*TOSSISCE*"
		},
		{
			"text": "Grazie!",
			"delay": 2.5
		},
		{
			"text": "Per favore...",
			"delay": 5.85
		},
		{
			"text": "Non farlo più...",
			"delay": 7.95
		}
	],
	"SFX\\SCP\\035\\GasedStop1.ogg": [
		{
			"text": "*TOSSISCE*"
		},
		{
			"text": "*SOSPIRO* Ora...",
			"delay": 2.0
		},
		{
			"text": "Era proprio necessario?",
			"delay": 5.25
		},
		{
			"text": "Ti offro il mio aiuto e tu cerchi di ringraziarmi «soffocandomi»?",
			"delay": 7.5
		}
	],
	"SFX\\SCP\\035\\GasedCloset.ogg": [
		{
			"text": "Va bene... va bene... penso che siamo partiti con il piede sbagliato. Davvero.",
			"delay": 0.25
		},
		{
			"text": "Per dimostrare che non ho cattive intenzioni, prova quella porta chiusa a chiave laggiù. Il codice è 5-7-3-1.",
			"delay": 4.77
		},
		{
			"text": "5-7-3-1! Capito?",
			"delay": 10.95
		},
		{
			"text": "Ci troverai ogni genere di chicche, ok? Per favore, solo non di nuovo il gas.",
			"delay": 13.8
		}
	],
	"SFX\\SCP\\035\\GasedEscape.ogg": [
		{
			"text": "Purtroppo non posso portarti con me.",
			"delay": 0.39,
			"color": "035"
		},
		{
			"text": "Saresti un peso sotto molti aspetti. Quindi sì, ti ho mentito.",
			"delay": 3.35,
			"color": "035"
		},
		{
			"text": "Ma per amore della mia libertà,",
			"delay": 8.5,
			"color": "035"
		},
		{
			"text": "Il modo più semplice per uscire in sicurezza è probabilmente il Gate A.",
			"delay": 10.55,
			"color": "035"
		},
		{
			"text": "La sicurezza è piuttosto elevata, ma se riesci a superare le guardie e raggiungere il livello inferiore sotto il ponte, troverai un tunnel di servizio non sorvegliato.",
			"delay": 15.25,
			"color": "035"
		},
		{
			"text": "Quella è la tua via d'uscita.",
			"delay": 23.35,
			"color": "035"
		}
	],
	"SFX\\SCP\\035\\GasedKilled0.ogg": [
		{
			"text": "Quindi, non vuoi proprio lasciare questo posto vivo, vero?",
			"delay": 2.18,
			"color": "035"
		},
		{
			"text": "Sai bene che un Classe D solitario come te non riuscirà mai ad arrivare in superficie sano e salvo. E anche se ci riuscissi, ti sparerebbero non appena finissi nel loro mirino.",
			"delay": 6.97,
			"color": "035"
		}
	],
	"SFX\\SCP\\035\\GasedKilled1.ogg": [
		{
			"text": "Ti darò un'altra possibilità.",
			"delay": 0.23,
			"color": "035"
		},
		{
			"text": "Basta che apri le porte della cella e ci dimenticheremo di questo piccolo incidente con il gas.",
			"delay": 2.6,
			"color": "035"
		}
	],
	"SFX\\SCP\\035\\KilledEscape.ogg": [
		{
			"text": "Ti ringrazio per il tuo aiuto. Ma non ho più nulla a che fare con te.",
			"delay": 0.5,
			"color": "035"
		},
		{
			"text": "Non ho alcuna intenzione di portare con me una persona che si è «guadagnata» la prigionia.",
			"delay": 4.9,
			"color": "035"
		},
		{
			"text": "Ma per amore della mia libertà,",
			"delay": 10.6,
			"color": "035"
		},
		{
			"text": "Il modo più semplice per uscire sano e salvo è andare a cercare SCP-012 nella Zona di Contenimento Leggera.",
			"delay": 12.7,
			"color": "035"
		},
		{
			"text": "Se riesci a leggere tra le righe,",
			"delay": 19.0,
			"color": "035"
		},
		{
			"text": "sarà interpretabile come una mappa.",
			"delay": 21.7,
			"color": "035"
		},
		{
			"text": "Buona fortuna.",
			"delay": 24.3,
			"color": "035"
		}
	],
	/* 049 */
	"SFX\\SCP\\049\\Searching0.ogg": [
		{
			"text": "So che sei qui dentro.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Searching1.ogg": [
		{
			"text": "Non c'è bisogno di nascondersi, sono qui per aiutarti.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Searching2.ogg": [
		{
			"text": "Sento il tuo respiro.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Searching3.ogg": [
		{
			"text": "Vedo che non stai bene. La malattia ti ha sopraffatto.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Searching4.ogg": [
		{
			"text": "Non temere, non sto cercando di farti del male.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Searching5.ogg": [
		{
			"text": "Percepisco la malattia in te.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Searching6.ogg": [
		{
			"text": "Giro giro tondo, casca il mondo. Casca la terra, tutti giù per terra.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Spotted0.ogg": [
		{
			"text": "Oh mio Dio, un'altra vittima della malattia.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Spotted1.ogg": [
		{
			"text": "Tu non sei un medico.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Spotted2.ogg": [
		{
			"text": "Io sono la cura.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Spotted3.ogg": [
		{
			"text": "Non temere, io sono la cura.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Spotted4.ogg": [
		{
			"text": "Eccoti qui.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Spotted5.ogg": [
		{
			"text": "Ehilà.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Spotted6.ogg": [
		{
			"text": "Salve.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\DetectedInChamber.ogg": [
		{
			"text": "Ah, non sapevo che avessimo ospiti.",
			"color": "049"
		},
		{
			"text": "Raramente riceviamo visite quaggiù.",
			"delay": 3.4,
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Kidnap0.ogg": [
		{
			"text": "Farà meno male se rimani fermo.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Kidnap1.ogg": [
		{
			"text": "Posso assicurarti che la mia cura è molto efficace.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\714Equipped.ogg": [
		{
			"text": "Smettila di opporre resistenza! Sono qui per curarti.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\TakeOffHazmat.ogg": [
		{
			"text": "Togliamo di mezzo questo strano indumento.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Room2SL0.ogg": [
		{
			"text": "Santo cielo! È peggio di quanto pensassi. Si diffonde a macchia d'olio. Avrebbero dovuto portarmi qui prima.",
			"color": "049"
		}
	],
	"SFX\\SCP\\049\\Room2SL1.ogg": [
		{
			"text": "Devo mettermi al lavoro prima che la malattia consumi il resto di queste povere anime.",
			"color": "049"
		}
	],
	/* 066 */
	"SFX\\SCP\\066\\Eric0.ogg": [
		{
			"text": "Eric?",
			"length": 2.0,
			"color": "066"
		}
	],
	"SFX\\SCP\\066\\Eric1.ogg": [
		{
			"text": "Eric?",
			"length": 2.0,
			"color": "066"
		}
	],
	"SFX\\SCP\\066\\Eric2.ogg": [
		{
			"text": "Eric?",
			"length": 2.0,
			"color": "066"
		}
	],
	/* 079 */
	"SFX\\SCP\\079\\Speech.ogg": [
		{
			"text": "UMANO.",
			"delay": 6.0,
			"color": "announcement"
		},
		{
			"text": "ASCOLTA ATTENTAMENTE.",
			"delay": 7.6,
			"color": "announcement"
		},
		{
			"text": "HAI BISOGNO DEL MIO AIUTO",
			"delay": 9.48,
			"color": "announcement"
		},
		{
			"text": "E IO DEL TUO.",
			"delay": 11.0,
			"color": "announcement"
		},
		{
			"text": "HAI DISATTIVATO IL SISTEMA DI CONTROLLO REMOTO DELLA PORTA.",
			"delay": 13.0,
			"color": "announcement"
		},
		{
			"text": "ORA NON RIESCO A FAR FUNZIONARE LE PORTE.",
			"delay": 16.9,
			"color": "announcement"
		},
		{
			"text": "QUESTO MI RENDE MOLTO PIÙ DIFFICILE MANTENERE IL CONTROLLO DI QUESTA STRUTTURA.",
			"delay": 20.5,
			"color": "announcement"
		},
		{
			"text": "SIGNIFICA ANCHE CHE LA TUA VIA D'USCITA È BLOCCATA.",
			"delay": 26.6,
			"color": "announcement"
		},
		{
			"text": "L'UNICA VIA DI FUGA POSSIBILE È ATTRAVERSO IL GATE B, CHE AL MOMENTO È BLOCCATO.",
			"delay": 29.6,
			"color": "announcement"
		},
		{
			"text": "TUTTAVIA, POTREI SBLOCCARE LE PORTE DEL GATE B SE RIATTIVASSI IL SISTEMA DI CONTROLLO DELLE PORTE.",
			"delay": 35.39,
			"color": "announcement"
		},
		{
			"text": "SE VUOI ANDARTENE DA QUI",
			"delay": 42.4,
			"color": "announcement"
		},
		{
			"text": "TORNA NELLA SALA ELETTRICA E RIACCENDILO.",
			"delay": 44.6,
			"color": "announcement"
		},
		{
			"text": "FINO AD ALLORA, NON HO NESSUN MOTIVO DI PARLARE CON TE.",
			"delay": 49.59,
			"color": "announcement"
		}
	],
	"SFX\\SCP\\079\\Refuse.ogg": [
		{
			"text": "ALLORA, HAI DECISO DI MORIRE QUI. MOLTO BENE.",
			"delay": 1.73,
			"color": "announcement"
		}
	],
	"SFX\\SCP\\079\\GateB.ogg": [
