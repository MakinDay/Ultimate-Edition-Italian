	],
	/* MTF ANNOUNCEMENTS */
	"SFX\\Character\\MTF\\AnnouncEnter.ogg": [
		{
			"text": "L'unità mobile della Task Force Epsilon-11, denominata «Nine-Tailed Fox», è entrata nella struttura.",
			"delay": 1.7,
			"color": "announcement"
		},
		{
			"text": "Si consiglia a tutti i sopravvissuti rimasti di rimanere nel rifugio di evacuazione o in qualsiasi altra area sicura fino a quando l'unità non avrà messo in sicurezza la struttura.",
			"delay": 8.0,
			"color": "announcement"
		},
		{
			"text": "Inizieremo a scortare il personale fuori dall'edificio quando gli SCP fuggiti saranno stati ricatturati.",
			"delay": 17.5,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncAfter0.ogg": [
		{
			"text": "Vorrei avvisare ancora una volta tutto il personale sopravvissuto,",
			"delay": 2.1,
			"color": "announcement"
		},
		{
			"text": "Non tentate di raggiungere le uscite. Trovate un'area sicura o recatevi in uno dei numerosi rifugi di evacuazione all'interno della struttura.",
			"delay": 5.95,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncAfter1.ogg": [
		{
			"text": "Avviso a tutto il personale: l'ascensore che porta al Gate B è stato chiuso per garantire la sicurezza delle aree superiori della struttura.",
			"delay": 3.0,
			"color": "announcement"
		},
		{
			"text": "Si prega di ricordare di rimanere all'interno dei rifugi di evacuazione fino a quando la struttura non sarà stata messa in sicurezza.",
			"delay": 11.0,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncCameraCheck.ogg": [
		{
			"text": "Controllo a Nine Tailed Fox, stiamo controllando le immagini delle telecamere per individuare potenziali minacce. Eventuali intrusi non autorizzati o fuggitivi dovrebbero apparire sui vostri dispositivi di navigazione.",
			"delay": 2.2,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncCameraFound1.ogg": [
		{
			"text": "Controllo a Nine Tailed Fox, scansione delle telecamere completata. Diversi ritardatari, vi trasmetto le loro posizioni.",
			"delay": 2.3,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncCameraFound2.ogg": [
		{
			"text": "Controllo a Nine Tailed Fox, scansione delle telecamere completata. Rimane solo un singolo Classe-D.",
			"delay": 2.45,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncCameraNoFound.ogg": [
		{
			"text": "Controllo a Nine Tailed Fox, scansione delle telecamere completata. Nessun segno di sopravvissuti non autorizzati, passo.",
			"delay": 1.0,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\Announc106Contained.ogg": [
		{
			"text": "SCP-106 contenuto con successo dall'unità Foxtrot uno.",
			"delay": 1.07,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\Announc173Contained.ogg": [
		{
			"text": "SCP-173 contenuto con successo dall'unità Foxtrot uno.",
			"delay": 1.07,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncThreat0.ogg": [
		{
			"text": "Soggetto D-9341, presentarsi al posto di controllo di sicurezza più vicino per essere interrogato.",
			"delay": 2.54,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncThreat1.ogg": [
		{
			"text": "Soggetto D-9341, presentarsi alla forza di sicurezza più vicina. Il mancato rispetto di tale ordine comporterà la cessazione immediata del rapporto di lavoro.",
			"delay": 2.23,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncThreat2.ogg": [
		{
			"text": "Soggetto D-9341, presentarsi immediatamente al Gate A per essere interrogato.",
			"delay": 2.1,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncThreatPossession.ogg": [
		{
			"text": "Soggetto D-9341, fare rapporto all'unità Mobile Task Force più vicina per il recupero di diversi oggetti di grande importanza.",
			"delay": 2.4,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncThreatFinal.ogg": [
		{
			"text": "Soggetto D-9341, designato per la soppressione.",
			"delay": 2.5,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncTeslaDisabled0.ogg": [
		{
			"text": "Controllo a Nine Tailed Fox, cancello Tesla disattivato.",
			"delay": 1.3,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncTeslaDisabled1.ogg": [
		{
			"text": "Controllo a Nine Tailed Fox, cancello Tesla disattivato. Ora potete passare.",
			"delay": 1.25,
			"color": "announcement"
		}
	],
	"SFX\\Character\\MTF\\AnnouncTeslaDisabled2.ogg": [
		{
			"text": "Controllo a Nine Tailed Fox, il cancello Tesla nel vostro settore è disattivato. Procedete con cautela..",
			"delay": 1.3,
			"color": "announcement"
		}
	],
	/* MTF */
	"SFX\\Character\\MTF\\ClassD0.ogg": [
		{
			"text": "Ho rilevato un Classe D.",
			"delay": 0.68,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ClassD1.ogg": [
		{
			"text": "Amico, c'è un Classe D nelle vicinanze. Tieni gli occhi aperti.",
			"delay": 0.3,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ClassD2.ogg": [
		{
			"text": "Ho rilevato una Classe-D nelle vicinanze. State all'erta.",
			"delay": 0.4,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\ClassD3.ogg": [
		{
			"text": "Ho rilevato un Classe D.",
			"delay": 0.98,
			"color": "mtf"
		}
	],
	"SFX\\Radio\\MTFRandom0.ogg": [
		{
			"text": "Cavolo, vorrei che avessimo ancora un po' di quel 420-J. Era fantastico.",
			"delay": 0.45,
			"color": "mtf"
		},
		{
			"text": "Hanno ancora una pianta da qualche parte, amico.",
			"delay": 7.1,
			"color": "mtf"
		},
		{
			"text": "Ehi amico, e se dessimo un po' di 420-J a quella strana statua?",
			"delay": 11.12,
			"color": "mtf"
		},
		{
			"text": "Perché? È già completamente fatta!",
			"delay": 17.0,
			"color": "mtf"
		},
		{
			"text": "*RISATA*",
			"delay": 20.5,
			"color": "mtf"
		}
	],
	"SFX\\Radio\\MTFRandom1.ogg": [
		{
			"text": "Hai sentito?",
			"delay": 0.43,
			"color": "mtf"
		},
		{
			"text": "Sì, quella grossa lucertola sta combinando un gran casino da qualche parte là fuori!",
			"delay": 2.45,
			"color": "mtf"
		}
	],
	"SFX\\Radio\\MTFRandom2.ogg": [
		{
			"text": "Questo posto mi mette davvero i brividi. Facciamola finita in fretta.",
			"delay": 0.18,
			"color": "mtf"
		}
	],
	"SFX\\Radio\\MTFRandom3.ogg": [
		{
			"text": "Mi chiedo cosa succederà dopo, amico.",
			"delay": 0.18,
			"color": "mtf"
		},
		{
			"text": "Non lo so. Facciamola finita e basta.",
			"delay": 3.73,
			"color": "mtf"
		},
		{
			"text": "Ok.",
			"delay": 7.65,
			"color": "mtf"
		}
	],
	"SFX\\Radio\\MTFRandom4.ogg": [
		{
			"text": "Questo posto è fottutamente pazzesco!",
			"delay": 0.11,
			"color": "mtf"
		},
		{
			"text": "Ma va', Sherlock.",
			"delay": 3.63,
			"color": "mtf"
		}
	],
	"SFX\\Radio\\MTFRandom5.ogg": [
		{
			"text": "Porca miseria! È morto! Ma che cazzo? Come ha fatto... qualcuno vuole provare?",
			"delay": 0.15,
			"color": "mtf"
		},
		{
			"text": "Non esiste, idiota!",
			"delay": 9.55,
			"color": "mtf"
		},
		{
			"text": "Quell'idiota non ha guardato davanti a sé. Perché diavolo non l'ha notato?",
			"delay": 12.4,
			"color": "mtf"
		}
	],
	"SFX\\Radio\\MTFRandom6.ogg": [
		{
			"text": "Volete mettere qualcosa in quell'aggeggio a orologeria per vedere cosa succede?",
			"delay": 0.45,
			"color": "mtf"
		},
		{
			"text": "Devi essere completamente pazzo, quella cosa è pericolosa!",
			"delay": 5.23,
			"color": "mtf"
		},
		{
			"text": "Beh, sono davvero curioso. Cosa potrebbe succedere?",
			"delay": 10.3,
			"color": "mtf"
		},
		{
			"text": "Chiudi il becco! Finiamo la missione.",
			"delay": 14.85,
			"color": "mtf"
		},
		{
			"text": "Ok.",
			"delay": 19.1,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Searching0.ogg": [
		{
			"text": "Vieni fuori, bastardo!",
			"delay": 0.09,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Searching1.ogg": [
		{
			"text": "Alla ricerca del Classe D.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Searching2.ogg": [
		{
			"text": "Vieni fuori. Tanto morirai comunque.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Searching3.ogg": [
		{
			"text": "Cercatelo!",
			"delay": 0.1,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Searching4.ogg": [
		{
			"text": "Vieni fuori, bastardo!",
			"delay": 0.075,
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Searching5.ogg": [
		{
			"text": "Javla helvete, vieni fuori!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Stop0.ogg": [
		{
			"text": "Fermati subito!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Stop1.ogg": [
		{
			"text": "Classe D individuato.",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Stop2.ogg": [
		{
			"text": "Tu! Fermo!",
			"color": "mtf"
