	/* RADIO */
	"SFX\\Radio\\Chatter0.ogg": [
		{
			"text": "Dottor Maynard, si presenti al Gate B.",
			"delay": 0.45
		},
		{
			"text": "Ehm, dottor Maynard, mi sente?",
			"delay": 6.7
		},
		{
			"text": "Sono l'agente Ulgrin, signore. Temo che il dottor Maynard sia ancora all'interno della struttura.",
			"delay": 9.67
		},
		{
			"text": "Oh, ehm, avete idea di dove si trovi o se sia ancora vivo?",
			"delay": 15.2
		},
		{
			"text": "Negativo, signore. Tutto quello che sappiamo è che non è ancora riuscito a uscire.",
			"delay": 20.1
		},
		{
			"text": "Ricevuto. Ehm, questo posto è un vero e proprio labirinto e lui lavora qui solo da una settimana. Quindi non c'è da stupirsi che non sia riuscito a trovare l'uscita. Spero che stia ancora resistendo.",
			"delay": 24.65
		},
		{
			"text": "Immagino che lo scopriremo quando entrerà in azione la task force mobile.",
			"delay": 35.6
		}
	],
	"SFX\\Radio\\Chatter1.ogg": [
		{
			"text": "Qui è il capo della sicurezza Franklin. Dottor Harp, mi riceve?",
			"delay": 0.35
		},
		{
			"text": "Sono il dottor Harp, sono impegnato, quindi la prego di fare in fretta.",
			"delay": 6.96
		},
		{
			"text": "Credo che il rapporto sull'incidente relativo alla violazione di 106 di questa mattina sia ancora sul suo computer.",
			"delay": 11.69
		},
		{
			"text": "Esatto. Se riesci a raggiungere il mio ufficio, sentiti libero di leggerlo.",
			"delay": 18.5
		},
		{
			"text": "Potremmo semplicemente leggere il file tramite la rete Intranet della struttura. Ovviamente, per farlo avremo bisogno del suo codice di accesso personale.",
			"delay": 23.45
		},
		{
			"text": "Oh sì, beh, ehm, va bene! Ehm, come ho detto sono piuttosto impegnato al momento, stiamo dando alcune istruzioni alla Task Force Mobile prima di mandarla sul posto. Arriverò lì e ti darò il codice quando avremo finito. Non dovrebbe volerci più di quindici minuti.",
			"delay": 30.9
		},
		{
			"text": "Mi dispiace, ma abbiamo bisogno di quel file immediatamente! Capisco che sia contro il protocollo di sicurezza. Ma date le circostanze, non potrebbe semplicemente darmi il codice via radio? A questo punto, non credo che la situazione possa peggiorare ulteriormente, indipendentemente da chi ci stia ascoltando in questo momento.",
			"delay": 44.1
		},
		{
			"text": "Beh, sì, penso che tu abbia ragione. Il codice è 7-8-1-6.",
			"delay": 62.8
		},
		{
			"text": "Ricevuto.",
			"delay": 69.78
		}
	],
	"SFX\\Radio\\Chatter2.ogg": [
		{
			"text": "Ehm, sembra che qualcuno abbia disattivato il sistema di controllo remoto delle porte.",
			"delay": 0.4
		}
	],
	"SFX\\Radio\\Chatter3.ogg": [
		{
			"text": "Movimento nel settore B.",
			"delay": 0.5
		},
		{
			"text": "Ehm, sembra essere un Classe D.",
			"delay": 3.4
		},
		{
			"text": "Eh, scommetto cinquanta dollari che non resisterà altri cinque minuti.",
			"delay": 7.85
		}
	],
	"SFX\\Radio\\Franklin0.ogg": [
		{
			"text": "L'unità mobile della Task Force Nine-Tailed Fox si sta preparando per entrare. Resisti! Presto sarà tutto finito.",
			"delay": 0.65
		}
	],
	"SFX\\Radio\\Franklin1.ogg": [
		{
			"text": "A tutti coloro che si trovano ancora all'interno della struttura, rimanete nei rifugi di evacuazione. Non cercate di raggiungere le uscite, indipendentemente da quanto siano vicine. I rifugi sono la vostra migliore possibilità di sopravvivere.",
			"delay": 0.6
		}
	],
	"SFX\\Radio\\Franklin2.ogg": [
		{
			"text": "A tutti coloro che stanno ancora ascoltando, eventi che alterano la realtà sono comuni durante violazioni di contenimento di questa portata. Non fidatevi dei vostri sensi! Non fidatevi di nessuno e di niente.",
			"delay": 0.635
		}
	],
	"SFX\\Radio\\Franklin3.ogg": [
		{
			"text": "A tutti coloro che stanno ancora ascoltando, eventi che alterano la realtà sono comuni durante violazioni di contenimento di questa portata.",
			"delay": 0.635
		},
		{
			"text": "Durante violazioni di contenimento di questa portata.",
			"delay": 8.22
		},
		{
			"text": "Durante violazioni di contenimento di questa portata.",
			"delay": 12.1
		},
		{
			"text": "*SUONI INCOMPRENSIBILI*",
			"delay": 15.61
		}
	],
	"SFX\\Radio\\OhGod.ogg": [
		{
			"text": "Pronto? C'è qualcuno?",
			"delay": 1.76
		},
		{
			"text": "Non so cosa... Non so...",
			"delay": 6.37
		},
		{
			"text": "Oh Dio, sta arrivando... Qualcuno, per favore, chiunque... per favore...",
			"delay": 9.85
		},
		{
			"text": "Qualcuno deve trasmettere immediatamente questa stazione, per favore...",
			"delay": 15.45
		},
		{
			"text": "Oh Dio, che cos'è quello? Che cos'è quello?",
			"delay": 20.7
		}
	],
	"SFX\\Radio\\RadioAlarm1.ogg": [
		{
			"text": "Questo sito sta subendo diverse violazioni di contenimento di livello Keter ed Euclid. Avviato il blocco totale del sito.",
			"delay": 0.62
		}
	],
	"SFX\\Radio\\SCPRadio1.ogg": [
		{
			"text": "Stai ascoltando la radio della fondazione SCP! La tua fonte 24 ore su 24, 7 giorni su 7, per messaggi preregistrati.",
			"delay": 4.0
		}
	],
	"SFX\\Radio\\SCPRadio2.ogg": [
		{
			"text": "Un promemoria: in caso di uno scenario apocalittico di classe XK, non fatevi prendere dal panico. Non servirà a nulla.",
			"delay": 3.2
		},
		{
			"text": "Niente potrà essere d'aiuto.",
			"delay": 11.3
		},
		{
			"text": "Tuttavia, farsi prendere dal panico è ciò che può essere meno d'aiuto.",
			"delay": 13.5
		}
	],
	"SFX\\Radio\\SCPRadio3.ogg": [
		{
			"text": "Segnalate immediatamente ai vostri superiori qualsiasi comportamento sospetto. Se non avete notato alcuna attività insolita di recente, significa che non state prestando abbastanza attenzione. Una minaccia alla sicurezza può provenire da qualsiasi fonte e nessuno è al di sopra di ogni sospetto. Nemmeno voi.",
			"delay": 2.9
		},
		{
			"text": "Rimanete paranoici. Rimanete vigili.",
			"delay": 18.92
		}
	],
	"SFX\\Radio\\SCPRadio4.ogg": [
		{
			"text": "Se doveste sentire una voce diversa annunciare alla radio interna della fondazione SCP, ignoratela completamente. Non è un dipendente della fondazione. Sta cercando di ingannarvi e non è affidabile. Qualsiasi consiglio vi dia porterà inevitabilmente alla distruzione, alla morte e al caos totale. È molto meglio che voi ascoltiate me.",
			"delay": 3.5
		}
	],
	"SFX\\Radio\\SCPRadio5.ogg": [
		{
			"text": "Nel caso estremamente improbabile di un'interruzione di corrente catastrofica e della conseguente violazione del contenimento dell'intera struttura, basta ricordare le regole fondamentali per affrontare la crisi. A sta per armi. B sta per battere le palpebre, in caso di mancanza di luce. E C sta per coraggio cardiovascolare. Come si suol dire, sparare, fissare e scappare! Oppure, dare in pasto al mostro in arrivo uno dei tuoi amici.",
			"delay": 3.8
		},
		{
			"text": "Rimanete vivi. Rimanete vigili.",
			"delay": 29.3
		}
	],
	"SFX\\Radio\\SCPRadio6.ogg": [
		{
			"text": "Ogni singola cosa che dice è una bugia.",
			"delay": 10.1
		},
		{
			"text": "Ogni cosa.",
			"delay": 14.7
		},
		{
			"text": "Non ascoltatelo.",
			"delay": 19.6
		},
		{
			"text": "Potete fidarvi di me.",
			"delay": 24.0
		},
		{
			"text": "Posso farvi uscire da qui.",
			"delay": 29.65
		},
		{
			"text": "Posso porarvi via da tutto questo.",
			"delay": 33.75
		},
		{
			"text": "Basta che ascoltiate me.",
			"delay": 40.4
		}
	],
	"SFX\\Radio\\SCPRadio7.ogg": [
		{
			"text": "Non dimenticate che il mercoledì è il giorno della pizza! Quindi recatevi alla mensa e prendetevi una fetta calda!",
			"delay": 2.6
		},
		{
			"text": "(La Fondazione SCP non si assume alcuna responsabilità per eventuali infortuni o malattie subiti o contratti durante la partecipazione al giorno della pizza.)",
			"delay": 11.7
		}
	],
	"SFX\\Radio\\SCPRadio8.ogg": [
		{
			"text": "Quando mangi nella mensa della struttura, ricordati sempre di controllare che nelle tue razioni non siano presenti le sette sostanze letali: stricnina, triossido di arsenico, nitrobenzene, mercurio, epicloridrina, acetone tiosemicarbazone e ragni. Rimanete in salute! Rimanete vigili.",
			"delay": 3.2
		}
	],
	/* ENDINGS - GATE A */
	"SFX\\Ending\\GateA\\Franklin.ogg": [
		{
			"text": "L'SCP-106 è fuggito dalla struttura al Gate A! Attivare immediatamente la torretta HID! Non lasciategli attraversare il ponte!",
			"color": "announcement"
		}
	],
	"SFX\\Ending\\GateA\\STOPRIGHTTHERE.ogg": [
		{
			"text": "Fermo dove sei!",
			"delay": 0.25,
			"color": "mtf"
		},
		{
			"text": "Il Classe D è stato trovato.",
			"delay": 3.75,
			"color": "mtf"
		}
	],
	"SFX\\Ending\\GateA\\CI.ogg": [
		{
			"text": "Sai troppo per lasciare che ti prendano. Tu verrai con noi.",
			"color": "chaos"
		}
	],
	"SFX\\Ending\\Ending0.ogg": [
		{
			"text": "Signore, abbiamo un grave problema qui!",
			"delay": 0.8,
			"color": "mtf"
		},
		{
			"text": "Per favore, spiegati meglio. Il bersaglio è già stato catturato?",
			"delay": 4.5,
			"color": "mtf"
		},
		{
			"text": "Non capisco cosa stia succedendo qui. Siamo entrati nel vecchio tunnel di servizio e questo si è... chiuso su di noi. Ora siamo intrappolati all'interno. Sanders è morto. Abbiamo perso il bersaglio!",
			"delay": 9.4,
			"length": 12.0,
			"color": "mtf"
		},
		{
			"text": "Stai dicendo che il tunnel ti è crollato addosso?",
			"delay": 21.9,
			"color": "mtf"
		},
		{
			"text": "No! Non è crollato. Sembrava un evento anomalo. Venga a vedere di persona e mandi qualcuno a tirarci fuori di qui!",
			"delay": 25.5,
			"color": "mtf"
		}
	],
	"SFX\\Ending\\Ending1.ogg": [
		{
			"text": "Registro dei test [CANCELLATO]. Soggetto [CANCELLATO]-[CANCELLATO].",
			"delay": 2.1
		},
		{
			"text": "Il soggetto dimostra una fortuna straordinaria e una padronanza assoluta anche delle circostanze più fatali, oltre a una straordinaria capacità di prevedere anche i pericoli più imprevedibili, quasi come se avesse già compiuto più volte queste imprese impossibili.",
			"delay": 7.8,
			"length": 16.0
		},
		{
			"text": "Sono necessari ulteriori test per determinare se il soggetto debba ricevere la classificazione SCP.",
			"delay": 24.4
		}
	],
	/* ENDINGS - GATE B */
	"SFX\\Ending\\GateB\\682Battle.ogg": [
		{
			"text": "L'SCP-682 è appena evaso dal Gate B. Voglio tutti gli elicotteri disponibili e le unità MTF al Gate B immediatamente!",
			"delay": 5.65,
			"color": "announcement"
		},
		{
			"text": "Ripeto, l'SCP-682 è fuori dalla struttura! Tutti gli elicotteri disponibili e le unità MTF al Gate B, subito!",
			"delay": 13.8,
			"color": "announcement"
		}
	],
	"SFX\\Ending\\GateB\\DetonatingAlphaWarheads.ogg": [
		{
			"text": "Faremo esplodere le testate Alpha tra 90 secondi! Si raccomanda a tutto il personale di salire a bordo dell'elicottero più vicino o di entrare immediatamente nel rifugio antiesplosione più vicino.",
			"delay": 0.42,
			"color": "announcement"
		}
	],
	"SFX\\Ending\\GateB\\AlphaWarheadsFail.ogg": [
		{
			"text": "Non siamo riusciti a far esplodere le testate per ragioni sconosciute. Tutti gli elicotteri e le unità MTF tornino immediatamente al Gate B. La cattura di SCP-682 è ora la nostra priorità.",
			"delay": 0.38,
			"color": "announcement"
		}
	],
	"SFX\\Ending\\GateB\\THEREHEIS.ogg": [
		{
			"text": "Eccolo là! Aprite il fuoco!",
			"color": "mtf"
		}
	],
	"SFX\\Ending\\Ending2.ogg": [
		{
			"text": "Signore, abbiamo trovato un Classe-D morto sulla passerella fuori dal Gate B. Ha diverse ferite da arma da fuoco al petto. Presumo che gli abbiano sparato mentre combattevamo contro l'SCP-682.",
			"delay": 0.5,
			"length": 12.0,
			"color": "mtf"
		},
		{
			"text": "Vorrei sapere come diavolo ha fatto un Classe D a superare il cancello? Portatemi i nastri di sicurezza di tutte le telecamere vicino al cancello e scoprite chi era di guardia lì, prima e durante il tentativo di fuga di 682.",
			"delay": 11.5,
			"length": 16.0,
			"color": "mtf"
		},
		{
			"text": "Ricevuto, signore.",
			"delay": 26.0,
			"color": "mtf"
		}
	],
	"SFX\\Ending\\Ending3.ogg": [
		{
			"text": "Qui CH-1 per OH-6, avete localizzato il bersaglio, passo?",
			"color": "mtf"
		},
		{
			"text": "OH-6 a CH-1, nessun segno del bersaglio. Credo che dovremmo inviare degli MTF-..",
			"delay": 6.05,
			"color": "mtf"
		},
		{
			"text": "*RUGGITO*",
			"delay": 10.95,
			"color": "682"
		},
		{
			"text": "CH-1 a OH-6, mi ricevi?",
			"delay": 14.95,
			"color": "mtf"
		}
	],
