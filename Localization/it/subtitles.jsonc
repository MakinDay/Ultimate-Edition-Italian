	],
	"SFX\\Character\\MTF\\Stop4.ogg": [
		{
			"text": "Ehi, ehi! Fermati!",
			"color": "mtf"
		}
	],
	"SFX\\Character\\MTF\\Stop5.ogg": [
		{
			"text": "Tu, fermati!",
